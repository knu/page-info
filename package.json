  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
